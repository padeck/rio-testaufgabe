# Copy to .env for local development.

# Optional: enables the OpenAI classification tier. Without it, the app
# always uses the deterministic rule-based ("simulated AI") classifier.
OPENAI_API_KEY=

# Optional override: auto | openai | simulated. Default: auto
# (tries OpenAI first if a key is set, otherwise falls back automatically).
AI_PROVIDER=auto

# Optional. If unset, falls back to a local SQLite file (./local.db).
DATABASE_URL=
